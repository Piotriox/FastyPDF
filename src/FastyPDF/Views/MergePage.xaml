<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FastyPDF.Views.MergePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FastyPDF.ViewModels"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="PDF Birleştir" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Birleştirmek istediğiniz PDF dosyalarını ekleyin." Opacity="0.75" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ListView
                ItemsSource="{x:Bind ViewModel.Files}"
                CanReorderItems="True"
                AllowDrop="True"
                CanDragItems="True"
                Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Details, Mode=OneWay}" Opacity="0.7" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="Kaldır"
                                Command="{Binding ViewModel.RemoveCommand, ElementName=RootPage}"
                                CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <FontIcon Glyph="&#xE8A5;" FontSize="32" />
                <TextBlock Text="PDF dosyalarınızı buraya sürükleyin" HorizontalAlignment="Center" />
                <TextBlock Text="veya" HorizontalAlignment="Center" Opacity="0.7" />
                <Button Content="PDF Seç" Command="{x:Bind ViewModel.AddFilesCommand}" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="PDF ekle" Command="{x:Bind ViewModel.AddFilesCommand}" />
            <Button Content="Birleştir" Command="{x:Bind ViewModel.MergeCommand}" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="İptal" Command="{x:Bind ViewModel.CancelCommand}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="8">
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.IsSuccessOpen, Mode=TwoWay}" Severity="Success" Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>

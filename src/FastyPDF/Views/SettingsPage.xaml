<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FastyPDF.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FastyPDF.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Ayarlar" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Genel Uygulama Ayarları -->
            <StackPanel Spacing="16">
                <TextBlock Text="Görünüm ve Tercihler" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox
                    Header="Tema"
                    Width="280"
                    ItemsSource="{x:Bind ViewModel.Themes}"
                    SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                    DisplayMemberPath="Label" />

                <TextBox Header="Varsayılan çıktı klasörü" Text="{x:Bind ViewModel.DefaultOutputFolder, Mode=TwoWay}" IsReadOnly="True" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Klasör seç" Command="{x:Bind ViewModel.PickOutputFolderCommand}" />
                    <Button Content="Son dosyaları temizle" Command="{x:Bind ViewModel.ClearRecentCommand}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" />
            </StackPanel>

            <MenuFlyoutSeparator Margin="0,8" />

            <!-- Klavye Kısayolları Rehberi -->
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Klavye Kısayolları" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Uygulama genelinde ve PDF okuyucuda kullanabileceğiniz tüm tuş kısayolları." Opacity="0.7" />
                </StackPanel>

                <!-- Kategori: Genel -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Genel Kısayollar" FontWeight="SemiBold" FontSize="15" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + O" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Yeni PDF belgesi veya dosya aç" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + W" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Açık olan belgeyi kapat" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Kategori: PDF Okuyucu -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="PDF Okuyucu" FontWeight="SemiBold" FontSize="15" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sol Ok / PageUp" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Önceki sayfaya git" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sağ Ok / PageDown" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Sonraki sayfaya git" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Home / End" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="İlk / Son sayfaya doğrudan atla" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + Fare Tekerleği" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Akıcı ve dinamik yakınlaştır / uzaklaştır" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + + / Ctrl + -" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Sayfayı yakınlaştır veya uzaklaştır" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl + 0" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Varsayılan gerçek boyuta sıfırla (%100)" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="F11" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Tam ekran moduna geç / çık" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ctrl + B" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Sol küçük resimler (sayfa listesi) panelini aç / gizle" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Ctrl + F" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Belge içi arama çubuğunu aç ve aramaya odaklan" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Ctrl + C" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="Mevcut sayfanın tüm metnini panoya kopyala" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Ctrl + D" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="Belge özellikleri (meta veriler, yazar, boyutlar) penceresi" />

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Ctrl + P" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="Belgeyi doğrudan yazıcıya gönder / yazdır" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Kategori: Sayfa Sıralama & Düzenleme -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Sayfa Sıralama &amp; Düzenleme (Organize)" FontWeight="SemiBold" FontSize="15" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + Z" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Yapılan sayfa değişikliğini geri al (Undo)" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Y" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Geri alınan değişikliği yinele (Redo)" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + S" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Düzenlenen sayfaları yeni PDF olarak kaydet" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Delete" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Seçili sayfaları belgeden sil" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FastyPDF.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="28" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
        <Image Source="ms-appx:///Assets/fastypdf.png" Height="72" Stretch="Uniform" HorizontalAlignment="Left" />
        <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind ViewModel.Version}" Opacity="0.7" />
        <TextBlock Text="{x:Bind ViewModel.Description}" TextWrapping="Wrap" />
        <TextBlock Text="İşlemler yalnızca bu cihazda çalışır. Belgeler bir sunucuya yüklenmez." TextWrapping="Wrap" Opacity="0.8" />
        <TextBlock Text="Lisans: MIT" Opacity="0.7" />
    </StackPanel>
</Page>

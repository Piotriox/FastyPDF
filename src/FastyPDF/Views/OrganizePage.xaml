<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FastyPDF.Views.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FastyPDF.ViewModels"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Sayfa Sıralama" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Sayfaları sürükleyerek sıralayın, seçip silin. Orijinal dosya değişmez." Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="PDF Seç" Command="{x:Bind ViewModel.OpenCommand}" />
            <Button Content="Geri al" Command="{x:Bind ViewModel.UndoCommand}" />
            <Button Content="Yinele" Command="{x:Bind ViewModel.RedoCommand}" />
            <Button Content="Seçilenleri sil" Click="Delete_Click" />
            <Button Content="Kaydet" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        <Grid Grid.Row="2">
            <GridView
                x:Name="PageGrid"
                ItemsSource="{x:Bind ViewModel.Pages}"
                SelectionMode="Multiple"
                CanReorderItems="True"
                CanDragItems="True"
                AllowDrop="True"
                Visibility="{x:Bind ViewModel.HasDocument, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageItemViewModel">
                        <StackPanel Width="120" Spacing="6">
                            <Border Height="160" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="{x:Bind DisplayNumber}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.HasDocument, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="PDF dosyanızı buraya sürükleyin" HorizontalAlignment="Center" />
                <Button Content="PDF Seç" Command="{x:Bind ViewModel.OpenCommand}" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="8">
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.IsSuccessOpen, Mode=TwoWay}" Severity="Success" Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>

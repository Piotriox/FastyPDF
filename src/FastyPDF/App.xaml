<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FastyPDF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FastyPDF.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="FastyAccentBrush" Color="#E31C23" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <x:Double x:Key="PagePadding">24</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
